# Is file ko ".env" naam se copy karein aur values bharein
# (Windows me: copy .env.example .env)

# Website ka port (local default 3001)
PORT=3001

# Kitne log register/login kar sakte hain
MAX_USERS=4

# ===== GOOGLE SHEET =====
# Sheet ki ID (URL me: docs.google.com/spreadsheets/d/YAHI_ID_HAI/edit)
SHEET_ID=

# Sirf INI tabs se data parha jayega (comma se separate)
SCRAPE_TABS=nexe-agent day time august,nexe-agent night time august

# Manual LinkedIn entries isi tab me save hongi
TRACKER_TAB=LinkedIn Tracker

# Service account JSON key ka path (LOCAL ke liye)
GOOGLE_CREDENTIALS=./credentials/service-account.json

# ===== CLOUD HOSTING (Render) KE LIYE =====
# Key file ka base64 version — credentials/env-values.txt me ready-made hai
# GOOGLE_CREDENTIALS_B64=

# Sessions ka secret (Render par render.yaml ye khud generate karta hai)
# SESSION_SECRET=
